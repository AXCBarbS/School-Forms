# Copy to .env (never commit the real file)
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=sf4.example.deped.gov.ph
DJANGO_CSRF_TRUSTED_ORIGINS=https://sf4.example.deped.gov.ph
# Approved DepEd e-mail domains (comma separated, exact match; subdomains must be listed explicitly)
DEPED_EMAIL_DOMAINS=deped.gov.ph
# PostgreSQL (leave DB_NAME empty to use SQLite)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# SMTP for OTP e-mails (console backend is used automatically when DJANGO_DEBUG=1 and EMAIL_HOST is empty)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=SF4 Portal <no-reply@example.deped.gov.ph>
# OTP policy
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
# Reverse proxy: set to 1 only if a trusted proxy sets X-Forwarded-Proto/For
DJANGO_BEHIND_PROXY=0
CURRENT_SCHOOL_YEAR=2026-2027
